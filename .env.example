BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE

# AI-помощник Cloud.ru. Оставьте OPENAI_API_KEY пустым для режима без AI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://foundation-models.api.cloud.ru/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V4-Pro
TEMPERATURE=0.8
MAX_TOKENS=1000
MAX_CONTEXT_MESSAGES=20
REQUEST_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Moscow

# Необязательно: путь к базе старого командного бота.
# Если архив распакован целиком, стандартный путь уже подходит.
# LEGACY_TEAM_DB_PATH=..\TgLP3\tasks.db
